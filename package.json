{
  "name": "clinot-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.js",
    "start": "node scripts/start-production.js",
    "start:next": "next start",
    "start:voroa": "sh voroa-start.sh",
    "start:railway": "sh railway-start.sh",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:seed:system": "tsx src/seed-system.ts",
    "db:seed:dev": "tsx src/seed-dev-user.ts",
    "db:seed:whatsapp": "tsx src/seed-whatsapp.ts",
    "db:import:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma && tsx scripts/import-sqlite-to-postgres.ts",
    "bootstrap:admin": "tsx src/bootstrap-admin.ts",
    "worker": "tsx src/lib/jobs/worker.ts",
    "setup": "prisma generate && prisma db push && tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.451.0",
    "next": "^14.2.15",
    "nodemailer": "^9.0.3",
    "openai": "^7.5.0",
    "pg": "8.23.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "vitest": "^4.1.10"
  }
}
