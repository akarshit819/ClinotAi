# === AUTHENTICATION ===
JWT_SECRET="change-this"
ENCRYPTION_KEY="change-this"

# === DATABASE ===
DATABASE_URL="file:./dev.db"

# === AI PROVIDER (OpenRouter is the SINGLE LLM provider) ===
OPENROUTER_API_KEY=""
# Optional: comma-separated free-model failover chain (preferred).
# Defaults to the built-in free candidates in src/lib/ai/openrouter-manager.ts.
# OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free"
# Legacy single-model override (used only when OPENROUTER_MODELS is unset).
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# === STRIPE ===
STRIPE_SECRET_KEY=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PROFESSIONAL_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# === EMAIL ===
RESEND_API_KEY=""
FROM_EMAIL=""

# === HOSTING ===
NEXT_PUBLIC_APP_URL=""

# === WHATSAPP / META ===
META_APP_ID=""
META_APP_SECRET=""
WA_WEBHOOK_SECRET=""
# Optional: WhatsApp Embedded Signup config ID. When set, the connect flow uses
# Meta's config-based embedded signup instead of the plain OAuth dialog.
META_WA_CONFIG_ID=""

# === DATABASE (PRODUCTION) ===
# PostgreSQL connection string (Voroa / Railway managed Postgres).
# Local dev uses your own Postgres instance via .env (git-ignored).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# === DEPLOYMENT / BOOT ===
# The web service listens on this port (set by the platform).
PORT="3000"
# SINGLE-SERVICE ARCHITECTURE: `npm run start` runs the web server AND an
# internal background job processor (WhatsApp queue, AI processing, retries,
# stale-job recovery) automatically — no separate worker service is needed.
# Optional: set to true to DISABLE the internal processor (e.g. when running
# a dedicated standalone worker via `npm run worker`).
CLINOT_DISABLE_INTERNAL_WORKER=""

# === ADMIN BOOTSTRAP (opt-in, fresh database only) ===
# Set CLINOT_BOOTSTRAP_ADMIN=true once on a new production database to create
# the initial owner account; remove it after the first successful login.
CLINOT_BOOTSTRAP_ADMIN=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Optional (defaults apply if unset):
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_CLINIC_NAME=""
BOOTSTRAP_CLINIC_COUNTRY=""
BOOTSTRAP_CLINIC_TIMEZONE=""

# === DEV/TEST SEED (never enable in production) ===
CLINOT_DEV_SEED=""

# === WHATSAPP BOOT PROVISIONING (opt-in, idempotent) ===
# When all three are set at boot, the WhatsApp Business account is linked to
# the clinic automatically (used by inbound webhooks + outbound replies).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
